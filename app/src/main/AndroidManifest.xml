<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.minhui.networkcapture">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
   <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
   <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
   -->

   <application
      android:name=".MyApplication"
      android:allowBackup="true"
      android:usesCleartextTraffic="true"
      android:extractNativeLibs="true"
      android:icon="@drawable/logo"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.AppCompat.Light.NoActionBar">

      <activity android:name="com.minhui.networkcapture.VPNCaptureActivity"
          android:theme="@style/MyMaterialTheme"
          android:exported="true">
          <intent-filter>
              <action android:name="android.intent.action.MAIN" />
              <category android:name="android.intent.category.LAUNCHER" />
          </intent-filter>
      </activity>

      <activity
          android:name="com.minhui.networkcapture.RadarActivities.PvPActivity"
          android:theme="@style/ToolbarTheme"/>

      <activity
          android:name="com.minhui.networkcapture.RadarActivities.HarvestingActivity"
          android:theme="@style/ToolbarTheme"/>

      <activity
          android:name="com.minhui.networkcapture.RadarActivities.MobsActivity"
          android:theme="@style/ToolbarTheme"/>

      <activity
          android:name="com.minhui.networkcapture.RadarActivities.ChestsActivity"
          android:theme="@style/ToolbarTheme"
          android:screenOrientation="fullSensor" />

      <activity
          android:name="com.minhui.networkcapture.RadarActivities.SettingsActivity"
          android:theme="@style/ToolbarTheme"/>

      <!-- PC 式“渲染选项”分组页：横竖屏自适应（竖屏单列 / 横屏两列）。
           不写 screenOrientation：跟随系统方向，Activity 重建时按新方向排版。 -->
      <activity
          android:name="com.minhui.networkcapture.RadarActivities.RenderOptionsActivity"
          android:theme="@style/ToolbarTheme" />

        <service
            android:name=".RadarDrawView"
            android:enabled="true"
            android:exported="false" />

    
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
