<?xml version="1.0" encoding="utf-8"?>
<!--
    悬浮窗内嵌「快速渲染选项」面板背景：
    深色半透明 + 橙色细描边，与 RenderOptionsActivity / 现有悬浮窗深色 UI 保持一致，
    同时保留一点透明度，避免完全遮住游戏画面。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#F21B1B1B" />

    <corners android:radius="10dp" />

    <stroke
        android:width="1dp"
        android:color="#99F4840B" />

    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />

</shape>
